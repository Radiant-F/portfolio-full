{
  "services": [
    {
      "name": "backend",
      "dockerfile": "Dockerfile",
      "buildCommand": null,
      "startCommand": "bun run src/index.ts",
      "port": 10000,
      "healthCheckPath": "/",
      "healthCheckTimeout": 30,
      "restartPolicy": "on-failure",
      "resourceLimits": {
        "cpu": "0.5",
        "memory": "512MB"
      }
    }
  ],
  "plugins": [
    {
      "id": "postgresql"
    }
  ]
}