# Database connection URL (provided by Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Default admin user credentials (optional - for seeding demo data)
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_PASSPHRASE=secure-password-here

# Seed on boot (set to "true", "1", "yes", or "on" to seed demo data on startup)
SEED_ON_BOOT=false

# Optional: Cloudinary credentials (if using Cloudinary for image storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=