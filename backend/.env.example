# Database
DATABASE_URL=postgresql://postgres:pass@host:port/name
DB_PASSWORD=for-docker

# JWT Secrets
JWT_ACCESS_SECRET=openssl;rand;base64;32
JWT_REFRESH_SECRET=openssl;rand;base64;32

# Default User
DEFAULT_USER_USERNAME=username
DEFAULT_USER_PASSPHRASE=ThePassphrase!123

# Cloudinary
CLOUDINARY_API_URL=cloudinary://key:secret@db
SEED_ON_BOOT=false